---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { PricingSection } from '../components/sections/PricingSection';
import { WaitlistSection } from '../components/sections/WaitlistSection';
import { MASTERY_PRICING_INR, MASTERY_PRICING_USD } from '../data/plans';
import { getSiteConfig } from '../lib/site';

const site = getSiteConfig();
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://ytschool.com';

const offerLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'YTSchool Mastery',
  description: 'Full access to YTSchool learning tools and curated content.',
  offers: [
    {
      '@type': 'Offer',
      priceCurrency: MASTERY_PRICING_INR.currency,
      price: String(MASTERY_PRICING_INR.monthly),
      url: `${siteUrl}/pricing`,
      availability: 'https://schema.org/InStock',
      name: 'Mastery monthly (INR)',
    },
    {
      '@type': 'Offer',
      priceCurrency: MASTERY_PRICING_INR.currency,
      price: String(MASTERY_PRICING_INR.yearly),
      url: `${siteUrl}/pricing`,
      availability: 'https://schema.org/InStock',
      name: 'Mastery yearly (INR)',
    },
    {
      '@type': 'Offer',
      priceCurrency: MASTERY_PRICING_USD.currency,
      price: String(MASTERY_PRICING_USD.monthly),
      url: `${siteUrl}/pricing`,
      availability: 'https://schema.org/InStock',
      name: 'Mastery monthly (USD)',
    },
    {
      '@type': 'Offer',
      priceCurrency: MASTERY_PRICING_USD.currency,
      price: String(MASTERY_PRICING_USD.yearly),
      url: `${siteUrl}/pricing`,
      availability: 'https://schema.org/InStock',
      name: 'Mastery yearly (USD)',
    },
  ],
};
---

<MarketingLayout
  title="Pricing"
  description="Start free with Viewer. Upgrade to Mastery for full YTSchool access — monthly or yearly pricing in INR or USD."
  canonical="/pricing"
  jsonLd={offerLd}
>
  <section class="border-b border-border bg-muted">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 lg:px-8">
      <h1 class="font-heading text-4xl font-semibold text-foreground sm:text-5xl">Pricing</h1>
      <p class="mt-4 text-muted-foreground">
        {
          site.appReady
            ? 'Transparent plans in INR and USD. Upgrade to Mastery in the app when you are ready.'
            : 'Transparent plans in INR and USD. Join the waitlist and we will notify you when billing opens.'
        }
      </p>
    </div>
  </section>
  <PricingSection
    client:load
    appReady={site.appReady}
    viewerHref={site.viewerLoginUrl}
    masteryHref={site.masteryBillingUrl}
    waitlistHref={site.waitlistHref}
  />
  {
    !site.appReady && (
      <WaitlistSection
        client:load
        waitlistUrl={site.waitlistUrl}
        waitlistToken={site.waitlistToken}
      />
    )
  }
</MarketingLayout>
