---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const gridPosts = featuredPost ? posts.slice(1) : posts;

function readingMinutes(body: string | undefined) {
  return Math.max(1, Math.ceil((body ?? '').trim().split(/\s+/).filter(Boolean).length / 200));
}
---

<MarketingLayout
  title="Blog"
  description="Essays and guides from YTSchool on deliberate learning with YouTube."
  canonical="/blog"
>
  <div class="blog-list container">
    <header class="blog-list__hero">
      <h1>Blog</h1>
      <p class="blog-list__lead">
        Practical notes on curated learning, habits, and making YouTube work for you.
      </p>
      <p class="blog-list__count">
        <strong>{posts.length}</strong>
        {posts.length === 1 ? ' article' : ' articles'}
      </p>
    </header>

    {
      featuredPost && (
        <article class="blog-card blog-card--featured">
          <div class="blog-card__body">
            <p class="blog-card__kicker">Featured</p>
            <p class="blog-card__meta">
              <time datetime={featuredPost.data.pubDate.toISOString()}>
                {featuredPost.data.pubDate.toLocaleDateString('en-US', {
                  day: 'numeric',
                  month: 'short',
                  year: 'numeric',
                })}
              </time>
              <span class="blog-card__dot" aria-hidden="true">·</span>
              <span>{readingMinutes(featuredPost.body)} min read</span>
            </p>
            <h2 class="blog-card__title">
              <a href={`/blog/${featuredPost.id}`}>{featuredPost.data.title}</a>
            </h2>
            <p class="blog-card__excerpt">{featuredPost.data.description}</p>
            <a class="blog-card__more" href={`/blog/${featuredPost.id}`}>Read more →</a>
          </div>
        </article>
      )
    }

    {
      gridPosts.length > 0 && (
        <div class="blog-list__grid">
          {gridPosts.map((post) => (
            <article class="blog-card">
              <div class="blog-card__body">
                <p class="blog-card__meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-US', {
                      day: 'numeric',
                      month: 'short',
                      year: 'numeric',
                    })}
                  </time>
                  <span class="blog-card__dot" aria-hidden="true">·</span>
                  <span>{readingMinutes(post.body)} min read</span>
                </p>
                <h2 class="blog-card__title">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h2>
                <p class="blog-card__excerpt">{post.data.description}</p>
                <a class="blog-card__more" href={`/blog/${post.id}`}>Read more →</a>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</MarketingLayout>

<style>
  .blog-list {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .blog-list__hero {
    max-width: 48rem;
    display: grid;
    gap: var(--space-xs);
  }

  .blog-list__hero h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .blog-list__lead {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .blog-list__count {
    margin: 0.25rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }

  .blog-list__count strong {
    color: var(--foreground);
    font-weight: 600;
  }

  .blog-list__grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
  }

  .blog-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-2xl);
    background: var(--card);
    overflow: hidden;
    height: 100%;
  }

  .blog-card__body {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
    padding: var(--space-lg);
  }

  .blog-card--featured .blog-card__body {
    gap: var(--space-md);
    padding: var(--space-2xl);
  }

  .blog-card__kicker {
    margin: 0;
    justify-self: start;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--muted-foreground);
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
  }

  .blog-card__dot {
    opacity: 0.5;
  }

  .blog-card__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .blog-card--featured .blog-card__title {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
  }

  .blog-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .blog-card__title a:hover {
    opacity: 0.8;
  }

  .blog-card__excerpt {
    margin: 0;
    color: var(--muted-foreground);
    line-height: 1.65;
    font-size: 0.9375rem;
  }

  .blog-card--featured .blog-card__excerpt {
    font-size: 1rem;
    max-width: 42rem;
  }

  .blog-card__more {
    margin-top: 0.25rem;
    color: var(--foreground);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .blog-card__more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
