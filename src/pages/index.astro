---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import VideoDemoSection from '../components/sections/VideoDemoSection.astro';
import TestimonialsSection from '../components/sections/TestimonialsSection.astro';
import InspirationQuoteSection from '../components/sections/InspirationQuoteSection.astro';
import GetStartedSection from '../components/sections/GetStartedSection.astro';
import { FeatureGroupSection } from '../components/sections/FeatureGroupSection';
import { PricingSection } from '../components/sections/PricingSection';
import { WaitlistSection } from '../components/sections/WaitlistSection';
import { FEATURE_GROUPS } from '../data/featureGroups';
import { getSiteConfig } from '../lib/site';

const site = getSiteConfig();

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'YTSchool',
  url: import.meta.env.PUBLIC_SITE_URL || 'https://ytschool.com',
  description:
    'Structured courses, learning paths, and cohorts built from the best YouTube videos.',
};
---

<MarketingLayout
  title="YTSchool — Curated Videos, Purposeful Learning"
  description="Structured courses, learning paths, and cohorts built from the best YouTube videos. Learn any skill without algorithm noise."
  canonical="/"
  jsonLd={organizationLd}
>
  <HeroSection />
  <section id="features" class="sr-only" aria-hidden="true"></section>
  {
    FEATURE_GROUPS.map((group) => (
      <FeatureGroupSection
        client:load
        group={group}
        ctaHref={site.appReady ? site.primaryCtaHref : site.waitlistHref}
        ctaLabel={group.ctaLabel}
      />
    ))
  }
  <VideoDemoSection />
  <PricingSection
    client:load
    appReady={site.appReady}
    viewerHref={site.viewerLoginUrl}
    masteryHref={site.masteryBillingUrl}
    waitlistHref={site.waitlistHref}
  />
  <TestimonialsSection />
  <InspirationQuoteSection />
  {!site.appReady && (
    <WaitlistSection
      client:load
      waitlistUrl={site.waitlistUrl}
      waitlistToken={site.waitlistToken}
    />
  )}
  <GetStartedSection />
</MarketingLayout>
