---

<section class="relative overflow-hidden border-t border-border bg-muted py-24">
  <div class="relative mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <header class="section-head">
      <p class="section-head__eyebrow">Product tour</p>
      <h2 class="section-head__title">See YTSchool in 90 seconds</h2>
      <p class="section-head__lead">
        A quick tour of the workspace, Learning Goals &amp; Paths, and cohorts.
      </p>
    </header>

    <div
      class="group relative mt-4 block aspect-video w-full overflow-hidden rounded-2xl border border-border bg-card shadow-md"
      role="img"
      aria-label="Product demo placeholder"
    >
      <div class="absolute inset-0 bg-muted/50"></div>
      <div class="absolute inset-0 flex items-center justify-center">
        <span class="relative flex h-20 w-20 items-center justify-center rounded-full bg-primary text-primary-foreground shadow-lg">
          <svg class="relative ml-1 h-8 w-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7L8 5z"></path>
          </svg>
        </span>
      </div>
      <div class="absolute bottom-4 left-4 inline-flex items-center gap-1.5 rounded-full border border-border bg-background/90 px-3 py-1 text-xs font-medium text-foreground backdrop-blur">
        90s product tour
      </div>
    </div>
  </div>
</section>
