---
const testimonials = [
  {
    quote: 'YTSchool turned my chaotic YouTube tabs into an actual learning plan. I finally finished a course.',
    name: 'Aarav S.',
    role: 'Frontend Engineer',
  },
  {
    quote: 'The Learning Goals & Paths are gold. I prepped for system design interviews using a single curated track.',
    name: 'Maya R.',
    role: 'Senior SDE',
  },
  {
    quote: 'Cohorts make it social. Learning with peers kept me on track for 8 straight weeks.',
    name: 'Daniel K.',
    role: 'Data Analyst',
  },
  {
    quote: 'Notes with timestamps changed how I revise. One click and I am back at the exact moment.',
    name: 'Priya M.',
    role: 'PM at a fintech',
  },
  {
    quote: 'I love that it respects my time. No fluff, no autoplay rabbit holes — just learning.',
    name: 'Tomás L.',
    role: 'Designer',
  },
  {
    quote: 'Podcast mode is brilliant for commutes. My daily learning hours doubled effortlessly.',
    name: 'Hana O.',
    role: 'Product Marketer',
  },
];

const loop = [...testimonials, ...testimonials];
---

<section id="testimonials" class="border-t border-border bg-background py-24">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <header class="section-head">
      <p class="section-head__eyebrow">Loved by learners</p>
      <h2 class="section-head__title">Real wins from deliberate learners</h2>
      <p class="section-head__lead">
        Stories from people who made YouTube work for them — not the other way around.
      </p>
    </header>
  </div>

  <div
    class="group relative mt-4 overflow-hidden"
    style="mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);"
  >
    <div class="flex w-max gap-4 animate-marquee group-hover:[animation-play-state:paused]">
      {
        loop.map((t) => {
          const initials = t.name
            .split(' ')
            .map((p) => p[0])
            .join('')
            .slice(0, 2)
            .toUpperCase();
          return (
            <article class="relative w-[320px] shrink-0 overflow-hidden rounded-xl border border-border bg-card p-6 sm:w-[360px]">
              <p class="text-sm leading-relaxed text-foreground">&ldquo;{t.quote}&rdquo;</p>
              <div class="mt-4 flex items-center gap-3 border-t border-border pt-4">
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-xs font-semibold text-primary-foreground">
                  {initials}
                </span>
                <div>
                  <p class="text-sm font-semibold text-foreground">{t.name}</p>
                  <p class="text-xs text-muted-foreground">{t.role}</p>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
