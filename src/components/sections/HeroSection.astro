---
import Button from '../ui/Button.astro';

const appUrl = (import.meta.env.PUBLIC_APP_URL || 'http://localhost:8080').replace(/\/$/, '');
---

<div class="hero-wrap relative isolate overflow-hidden">
  <span class="bg-grid" aria-hidden="true"></span>
  <span class="bg-glow" aria-hidden="true"></span>

  <section class="container relative flex flex-col items-center px-4 pb-20 pt-20 text-center sm:px-6 lg:px-8 lg:pt-28">
    <p class="section-head__eyebrow">Learn from the best of YouTube — without the noise</p>

    <h1 class="mt-4 max-w-4xl text-balance font-heading text-4xl font-semibold tracking-tight text-foreground sm:text-5xl lg:text-6xl">
      Curated videos, purposeful learning.
    </h1>

    <p class="mt-6 max-w-2xl text-pretty text-base text-muted-foreground sm:text-lg">
      YTSchool turns the world&apos;s best YouTube content into structured
      Learning Goals &amp; Paths and live cohorts — so every minute you
      spend watching moves you forward.
    </p>

    <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row">
      <Button href={`${appUrl}/login`} variant="primary" size="lg">
        Get started
        <span aria-hidden>→</span>
      </Button>
      <Button href="#features-paths" variant="secondary" size="lg">
        See how it works
      </Button>
    </div>
  </section>
</div>
