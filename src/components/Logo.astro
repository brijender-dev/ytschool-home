---
interface Props {
  className?: string;
  variant?: 'full' | 'mark';
}

const { className = 'h-8', variant = 'full' } = Astro.props;
---

<span class:list={['logo inline-flex items-center gap-2 font-semibold tracking-tight text-foreground', className]}>
  <img
    class="logo__mark h-full w-auto"
    src="/ytschool-logo.png"
    width="32"
    height="32"
    alt=""
    decoding="async"
  />
  {variant === 'full' && <span class="logo__wordmark text-lg font-heading">YTSchool</span>}
</span>

<style>
  .logo__mark {
    display: block;
    flex-shrink: 0;
  }

  .logo__wordmark {
    font-family: var(--font-heading);
  }
</style>
