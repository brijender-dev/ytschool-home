---
import Logo from './Logo.astro';

const appUrl = (import.meta.env.PUBLIC_APP_URL || 'http://localhost:8080').replace(/\/$/, '');
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Features', href: '/#features' },
      { label: 'Pricing', href: '/pricing' },
      { label: 'Docs', href: '/docs' },
      { label: 'Blog', href: '/blog' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Content Policy', href: `${appUrl}/content-policy` },
      { label: 'Disclaimer', href: `${appUrl}/disclaimer` },
      { label: 'Takedown Policy', href: `${appUrl}/takedown-policy` },
    ],
  },
];

const socialLinks = [
/*  {
    label: 'GitHub',
    href: 'https://github.com/ytschool',
    external: true,
    icon: 'github' as const,
  },*/
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/company/ytschool-learning',
    external: true,
    icon: 'linkedin' as const,
  },
  {
    label: 'Email',
    href: 'mailto:brijender@ytschool.com',
    external: false,
    icon: 'email' as const,
  },
];
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" aria-label="YTSchool home">
          <Logo variant="full" class="h-8" />
        </a>
        <p>Structured courses and learning paths built from the best YouTube videos.</p>
      </div>

      {
        columns.map((col) => (
          <div class="footer__column">
            <h2>{col.title}</h2>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="footer__column footer__social">
        <h2>Social</h2>
        <ul>
          {
            socialLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...(link.external ? { target: '_blank', rel: 'noreferrer' } : {})}
                >
                  {link.icon === 'github' && (
                    <svg
                      class="footer__social-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4"></path>
                      <path d="M9 18c-4.51 2-5-2-7-2"></path>
                    </svg>
                  )}
                  {link.icon === 'linkedin' && (
                    <svg
                      class="footer__social-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path>
                      <rect x="2" y="9" width="4" height="12"></rect>
                      <circle cx="4" cy="4" r="2"></circle>
                    </svg>
                  )}
                  {link.icon === 'email' && (
                    <svg
                      class="footer__social-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                    </svg>
                  )}
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="footer__meta">
      <p>&copy; {year} YTSchool. All rights reserved.</p>
      <p class="footer__tagline">
        Built
        <span class="footer__heart-wrap" aria-hidden="true">
          <svg class="footer__heart" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
            ></path>
          </svg>
        </span>
        for curious learners.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    background: var(--secondary);
  }

  .footer__inner {
    padding-block: var(--space-2xl) var(--space-lg);
  }

  .footer__grid {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1.4fr repeat(4, minmax(0, 1fr));
  }

  .footer__brand p {
    margin: var(--space-md) 0 0;
    color: var(--muted-foreground);
    line-height: 1.6;
    font-size: 0.9375rem;
  }

  .footer__column h2 {
    margin: 0 0 var(--space-sm);
    font-size: 0.9375rem;
  }

  .footer__column ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .footer__column a {
    color: var(--muted-foreground);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .footer__column a:hover {
    color: var(--foreground);
  }

  .footer__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer__social-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .footer__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
    color: var(--muted-foreground);
    font-size: 0.8125rem;
  }

  .footer__tagline {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }

  .footer__heart-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }

  .footer__heart {
    width: 0.9em;
    height: 0.9em;
    color: #e11d48;
    transform-origin: center;
    animation: footer-heartbeat 1.6s ease-in-out infinite;
  }

  @keyframes footer-heartbeat {
    0%,
    100% {
      transform: scale(1);
    }
    14% {
      transform: scale(1.18);
    }
    28% {
      transform: scale(1);
    }
    42% {
      transform: scale(1.12);
    }
    56% {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__heart {
      animation: none;
    }
  }

  @media (max-width: 60rem) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 40rem) {
    .footer__grid,
    .footer__meta {
      grid-template-columns: 1fr;
      display: grid;
    }
  }
</style>
